# ============================================================
# Environment Configuration — copy to .env and fill in values
# ============================================================

# Application
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO

# Tesseract OCR binary path (Windows example)
TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
# TESSERACT_CMD=/usr/bin/tesseract   # Linux

# Poppler path for pdf2image (Windows example)
POPPLER_PATH=C:\poppler\Library\bin
# POPPLER_PATH=                       # Linux (auto-detected)

# Grounding DINO model (HuggingFace model ID)
GROUNDING_DINO_MODEL=IDEA-Research/grounding-dino-base

# Device: "cpu" or "cuda"
DEVICE=cpu

# Data directories
SAMPLE_DRAWINGS_DIR=data/sample_drawings
OUTPUTS_DIR=data/outputs

# Upload limits
MAX_UPLOAD_SIZE_MB=50
